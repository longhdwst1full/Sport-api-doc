PORT=4000
NODE_ENV=development
APP_MODE=serve
CORS_ORIGINS=*
AUTH_BYPASS=true
AUTH_TOKEN_TRANSPORT=BODY
JWT_ACCESS_SECRET=development-only-change-this-jwt-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
DATABASE_ENABLED=true
DB_MIGRATE_ON_START=true
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:56379
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sport-sys/sport
