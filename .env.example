# Sports API environment template.
# Copy to .env for a non-Vercel server, or add the same keys in
# Vercel Project Settings > Environment Variables. Never commit real secrets.
# Local development may continue using .env.local; this change does not modify it.

# Application
PORT=4000
NODE_ENV=development
APP_MODE=serve
LOG_LEVEL=info

# Development may use *. Production validation requires the exact client/admin
# origins as a comma-separated list, for example:
# CORS_ORIGINS=https://sport-client.example.com,https://sport-admin.example.com
CORS_ORIGINS=*

# Authentication
# Development may temporarily bypass permission checks. Production must use
# AUTH_BYPASS=false and AUTH_TOKEN_TRANSPORT=COOKIE.
AUTH_BYPASS=true
AUTH_TOKEN_TRANSPORT=BODY
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Supabase PostgreSQL / Prisma
DATABASE_ENABLED=true

# Run pending migrations when a long-running API process starts.
DB_MIGRATE_ON_START=true

# Run pending migrations during a Vercel production build. VERCEL and
# VERCEL_ENV are injected automatically by Vercel and must not be added here.
DB_MIGRATE_ON_DEPLOY=true

# Runtime queries use the Supabase transaction-mode pooler on port 6543.
# Copy the exact URI from Supabase Dashboard > Connect > ORMs > Prisma.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations use the Supabase session-mode pooler on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional cache. Remove this key when Redis is not provisioned.
REDIS_URL=redis://localhost:56379

# Request throttling
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Cloudinary media storage. Configure these as secrets in Vercel.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sport-sys/sport

# Telegram command bot (optional). Keep disabled unless all values are set.
# Add real values to Vercel Project Environment Variables, never to Git.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-letters-numbers-underscore-or-hyphen
TELEGRAM_WEBHOOK_URL=https://your-api.example.com/api/v1/integrations/telegram/webhook

# Local Codex bridge (never enable this on Vercel). The worker accepts only
# api/admin/client aliases, requires /confirm, and runs Codex workspace-write.
TELEGRAM_CODEX_ENABLED=false
TELEGRAM_CODEX_WORKSPACE_ROOT=/absolute/path/to/dctd-utc
TELEGRAM_CODEX_DEFAULT_REPO=api
TELEGRAM_CODEX_TIMEOUT_MS=1800000
TELEGRAM_CODEX_STATE_FILE=.telegram-codex/state.json
