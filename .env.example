PORT=4000
NODE_ENV=development
CORS_ORIGINS=*
AUTH_BYPASS=true
AUTH_TOKEN_TRANSPORT=BODY
JWT_ACCESS_SECRET=development-only-change-this-jwt-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
DATABASE_ENABLED=false
DATABASE_URL=postgresql://dctd:dctd_local@localhost:55432/dctd_utc
DIRECT_URL=postgresql://dctd:dctd_local@localhost:55432/dctd_utc
REDIS_URL=redis://localhost:56379
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sport-sys/sport
