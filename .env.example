# Sports API environment template.
# Copy to .env for a non-Vercel server, or add the same keys in
# Vercel Project Settings > Environment Variables. Never commit real secrets.
# Local development may continue using .env.local; this change does not modify it.

# Application
PORT=4000
NODE_ENV=development
APP_MODE=serve
LOG_LEVEL=info

# Development may use *. Production validation requires the exact client/admin
# origins as a comma-separated list, for example:
# CORS_ORIGINS=https://sport-client.example.com,https://sport-admin.example.com
CORS_ORIGINS=*

# Authentication
# Deny by default. Local development may explicitly set AUTH_BYPASS=true;
# production must keep false and use AUTH_TOKEN_TRANSPORT=COOKIE.
AUTH_BYPASS=false
AUTH_TOKEN_TRANSPORT=BODY
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Supabase PostgreSQL / Prisma
DATABASE_ENABLED=true

# Run pending migrations when a long-running API process starts.
DB_MIGRATE_ON_START=true

# Run pending migrations during a Vercel production build. VERCEL and
# VERCEL_ENV are injected automatically by Vercel and must not be added here.
DB_MIGRATE_ON_DEPLOY=true

# Runtime queries use the Supabase transaction-mode pooler on port 6543.
# Copy the exact URI from Supabase Dashboard > Connect > ORMs > Prisma.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma migrations use the Supabase session-mode pooler on port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional cache. Remove this key when Redis is not provisioned.
REDIS_URL=redis://localhost:56379

# Request throttling
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Checkout business parameters. Integer minutes, allowed range 5..1440.
CHECKOUT_RESERVATION_TTL_MINUTES=30
GUEST_CART_TTL_DAYS=30
ORDER_COMPLETION_HOLD_HOURS=72
# BANK_TRANSFER pending timeout; submitting verified evidence stops expiry.
PAYMENT_TIMEOUT_MINUTES=30

# Reservation expiry cron. The scheduler calls the internal endpoint with
# Authorization: Bearer <CRON_SECRET>. Use a random value of at least 32 chars.
RESERVATION_EXPIRY_JOB_ENABLED=false
RESERVATION_EXPIRY_JOB_BATCH_SIZE=50
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters
# Used only by yarn cron:reservation:set after the API has been deployed.
RESERVATION_EXPIRY_JOB_URL=https://your-api.example.com/api/v1/internal/jobs/reservations/expire
RESERVATION_EXPIRY_CRON_SCHEDULE=*/5 * * * *
# Flash sale quota expiry cron. Trả suất flash về pool khi khách giữ chỗ quá TTL
# mà không đặt đơn; không có job này thì suất bị giữ vô thời hạn.
FLASH_SALE_QUOTA_EXPIRY_JOB_ENABLED=false
FLASH_SALE_QUOTA_EXPIRY_JOB_BATCH_SIZE=50
FLASH_SALE_QUOTA_EXPIRY_JOB_URL=https://your-api.example.com/api/v1/internal/jobs/flash-sales/expire-quota
FLASH_SALE_QUOTA_EXPIRY_CRON_SCHEDULE=*/5 * * * *
PAYMENT_EXPIRY_JOB_ENABLED=false
PAYMENT_EXPIRY_JOB_BATCH_SIZE=50
ORDER_COMPLETION_JOB_ENABLED=false
ORDER_COMPLETION_JOB_BATCH_SIZE=50
ORDER_MAINTENANCE_JOB_URL=https://your-api.example.com/api/v1/internal/jobs/orders/maintenance
ORDER_MAINTENANCE_CRON_SCHEDULE=*/5 * * * *

# Shipping orchestration. Keep providers disabled until credentials and branch
# pickup mappings are configured. Free-radius applies only when both coordinates exist.
SHIPPING_FREE_RADIUS_KM=10
SHIPPING_PROVIDER_TIMEOUT_MS=5000
SHIPPING_SMALL_MAX_WEIGHT_GRAMS=5000
SHIPPING_MEDIUM_MAX_WEIGHT_GRAMS=20000
SHIPPING_SMALL_FEE_VND=50000
SHIPPING_MEDIUM_FEE_VND=100000
SHIPPING_LARGE_FEE_VND=200000
GHN_ENABLED=false
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api/v2/shipping-order/fee
GHN_TOKEN=replace-with-ghn-token
GHN_SHOP_ID=123456

# Cloudinary media storage. Configure these as secrets in Vercel.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=sport-sys/sport

# Mailtrap email sending (optional). Để trống MAILTRAP_API_TOKEN thì tính năng email tắt.
# Lấy token tại https://mailtrap.io/api-tokens — chỉ đặt giá trị thật trong Vercel env, không commit.
MAILTRAP_API_TOKEN=
# Sender phải thuộc domain đã verify trong Mailtrap; demomailtrap.co chỉ gửi được tới chính chủ tài khoản.
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME=Bảo An Sport
# Ngoài production, mọi email chuyển hướng về địa chỉ này để không gửi nhầm khách hàng thật.
MAILTRAP_REDIRECT_ALL_TO=

# VNPay sandbox payment gateway (optional). Both credentials are required to enable it.
# Put real credentials only in ignored .env.local/.env.production or deployment secrets.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-storefront.example.com/checkout/vnpay-return
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15

# Telegram command bot (optional). Keep disabled unless all values are set.
# Add real values to Vercel Project Environment Variables, never to Git.
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-letters-numbers-underscore-or-hyphen
TELEGRAM_WEBHOOK_URL=https://your-api.example.com/api/v1/integrations/telegram/webhook

# Local Codex bridge (never enable this on Vercel). The worker accepts only
# api/admin/client aliases, requires /confirm, and runs Codex workspace-write.
TELEGRAM_CODEX_ENABLED=false
TELEGRAM_CODEX_WORKSPACE_ROOT=/absolute/path/to/dctd-utc
TELEGRAM_CODEX_DEFAULT_REPO=api
TELEGRAM_CODEX_TIMEOUT_MS=1800000
TELEGRAM_CODEX_STATE_FILE=.telegram-codex/state.json

# GHN — tạo vận đơn, đồng bộ trạng thái và in phiếu giao
# Bật GHN_ENABLED khi đã có token thật; thiếu bất kỳ giá trị nào thì tạo vận đơn tự động tắt hẳn.
GHN_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
# Điểm lấy hàng KHÔNG cấu hình ở đây: nó là địa chỉ chi nhánh xuất đơn, lưu trong
# branches.address_json (districtCode/wardCode). Admin chọn qua API địa giới của GHN.
# 2 = hàng nhẹ, 5 = hàng nặng theo phân loại dịch vụ của GHN.
GHN_SERVICE_TYPE_ID=2
# Webhook trạng thái giao hàng. Khai báo ở cổng GHN đúng URL này, kèm secret trong query string
# vì cổng GHN chỉ lưu được URL, không thêm được header:
#   https://sport-api-doc.vercel.app/api/v1/integrations/ghn/webhook?secret=<GHN_WEBHOOK_SECRET>
# GHN_WEBHOOK_ACTOR_USER_ID phải là users.id có thật (transition ghi audit, audit khoá ngoại users).
GHN_WEBHOOK_SECRET=
GHN_WEBHOOK_ACTOR_USER_ID=3827558
