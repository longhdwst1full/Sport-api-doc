  lineNo              Int      @map("line_no")
  productVariantId    BigInt   @map("product_variant_id")
  productBundleId     BigInt?  @map("product_bundle_id")
  itemType            String   @default("STANDARD") @map("item_type") @db.VarChar(24)
  skuSnapshot         String   @map("sku_snapshot") @db.VarChar(64)
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  variantNameSnapshot String   @map("variant_name_snapshot") @db.VarChar(255)
  attributesSnapshot  Json?    @map("attributes_snapshot") @db.JsonB
  imageUrlSnapshot    String?  @map("image_url_snapshot")
  quantity            Int
  listUnitPrice       Decimal  @map("list_unit_price") @db.Decimal(19, 2)
  discountAmount      Decimal  @default(0) @map("discount_amount") @db.Decimal(19, 2)
  finalUnitPrice      Decimal  @map("final_unit_price") @db.Decimal(19, 2)
  taxAmount           Decimal  @default(0) @map("tax_amount") @db.Decimal(19, 2)
  lineTotal           Decimal  @map("line_total") @db.Decimal(19, 2)
  unitCostSnapshot    Decimal? @map("unit_cost_snapshot") @db.Decimal(19, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productVariant ProductVariant       @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  productBundle  ProductBundle?       @relation(fields: [productBundleId], references: [id], onDelete: Restrict)
  components     OrderItemComponent[]
  reviews             ProductReview[]
  returnItems         ReturnItem[]

  @@unique([orderId, lineNo])
  @@index([productVariantId])
  @@index([productBundleId])
  @@map("order_items")
}

model OrderItemComponent {
  id                 BigInt   @id @default(autoincrement())
  orderItemId        BigInt   @map("order_item_id")
  bundleItemId       BigInt?  @map("bundle_item_id")
  componentVariantId BigInt   @map("component_variant_id")
  skuSnapshot        String   @map("sku_snapshot") @db.VarChar(64)
  nameSnapshot       String   @map("name_snapshot") @db.VarChar(255)
  quantityPerBundle  Int      @map("quantity_per_bundle")
  totalQuantity      Int      @map("total_quantity")
  unitCostSnapshot   Decimal? @map("unit_cost_snapshot") @db.Decimal(19, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  bundleItem       BundleItem?    @relation(fields: [bundleItemId], references: [id], onDelete: Restrict)
  componentVariant ProductVariant @relation(fields: [componentVariantId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, componentVariantId])
  @@index([bundleItemId])
  @@index([componentVariantId])
  @@map("order_item_components")
}

model OrderAddress {
  id             BigInt  @id @default(autoincrement())
  orderId        BigInt  @map("order_id")
  addressType    String  @default("SHIPPING") @map("address_type") @db.VarChar(24)
  recipientName  String  @map("recipient_name") @db.VarChar(255)
  recipientPhone String  @map("recipient_phone") @db.VarChar(32)
  recipientEmail String? @map("recipient_email") @db.VarChar(255)
  addressLine    String  @map("address_line") @db.VarChar(500)
  wardCode       String? @map("ward_code") @db.VarChar(32)
  wardName       String? @map("ward_name") @db.VarChar(255)
  districtCode   String? @map("district_code") @db.VarChar(32)
  districtName   String? @map("district_name") @db.VarChar(255)
  provinceCode   String  @map("province_code") @db.VarChar(32)
  provinceName   String  @map("province_name") @db.VarChar(255)
  postalCode     String? @map("postal_code") @db.VarChar(20)
  countryCode    String  @default("VN") @map("country_code") @db.Char(2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, addressType])
  @@index([recipientPhone])
  @@index([recipientEmail])
  @@map("order_addresses")
}

model OrderStatusHistory {
  id         BigInt   @id @default(autoincrement())
  orderId    BigInt   @map("order_id")
  sequenceNo Int      @map("sequence_no")
  fromStatus String?  @map("from_status") @db.VarChar(32)
  toStatus   String   @map("to_status") @db.VarChar(32)
  reason     String?  @db.VarChar(500)
  actorType  String   @map("actor_type") @db.VarChar(24)
  actorId    BigInt?  @map("actor_id")
  requestId  String   @map("request_id") @db.VarChar(100)
  idempotencyKey String? @map("idempotency_key") @db.VarChar(150)
  requestHash String? @map("request_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, sequenceNo])
  @@unique([orderId, idempotencyKey])
  @@index([orderId, createdAt])
  @@index([requestId])
  @@map("order_status_history")
}

model Payment {
  id             BigInt    @id @default(autoincrement())
  orderId        BigInt    @unique @map("order_id")
  paymentRef     String    @unique @map("payment_ref") @db.VarChar(64)
  method         String    @db.VarChar(32)
  status         String    @default("PENDING") @db.VarChar(32)
  expectedAmount Decimal   @map("expected_amount") @db.Decimal(19, 2)
  receivedAmount Decimal   @default(0) @map("received_amount") @db.Decimal(19, 2)
  currencyCode   String    @default("VND") @map("currency_code") @db.Char(3)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)
  confirmedBy    BigInt?   @map("confirmed_by")
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  failureReason  String?   @map("failure_reason") @db.VarChar(500)
  version        BigInt    @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  confirmer    User?                @relation("PaymentConfirmer", fields: [confirmedBy], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]
  refunds      Refund[]
  evidences    PaymentEvidence[]

  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([method, status, expiresAt])
  @@index([confirmedBy])
  @@map("payments")
}

model PaymentTransaction {
  id                 BigInt   @id @default(autoincrement())
  paymentId          BigInt   @map("payment_id")
  transactionType    String   @map("transaction_type") @db.VarChar(32)
  provider           String?  @db.VarChar(64)
  externalId         String?  @map("external_id") @db.VarChar(255)
  externalEventId    String?  @map("external_event_id") @db.VarChar(255)
  idempotencyKey     String   @unique @map("idempotency_key") @db.VarChar(150)
  requestHash        String   @map("request_hash") @db.Char(64)
  amount             Decimal  @db.Decimal(19, 2)
  currencyCode       String   @map("currency_code") @db.Char(3)
  status             String   @db.VarChar(32)
  rawPayloadRedacted Json?    @map("raw_payload_redacted") @db.JsonB
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([provider, externalId])
  @@map("payment_transactions")
}

model PaymentEvidence {
  id           BigInt    @id @default(autoincrement())
  paymentId    BigInt    @map("payment_id")
  mediaAssetId BigInt    @unique @map("media_asset_id")
  uploadedBy   BigInt?   @map("uploaded_by")
  uploaderType String    @map("uploader_type") @db.VarChar(24)
  guestAccessId String?  @map("guest_access_id") @db.VarChar(100)
  fileHash     String    @map("file_hash") @db.VarChar(128)
  note         String?   @db.VarChar(1000)
  status       String    @default("PENDING_REVIEW") @db.VarChar(24)
  reviewedBy   BigInt?   @map("reviewed_by")
  reviewedAt   DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewReason String?   @map("review_reason") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment   Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)
  uploader  User?      @relation("PaymentEvidenceUploader", fields: [uploadedBy], references: [id], onDelete: Restrict)
  reviewer  User?      @relation("PaymentEvidenceReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@unique([paymentId, fileHash])
  @@index([paymentId, status, createdAt(sort: Desc)])
  @@index([uploadedBy])
  @@index([reviewedBy])
  @@map("payment_evidences")
}

model Fulfillment {
  id                         BigInt    @id @default(autoincrement())
  orderId                    BigInt    @unique @map("order_id")
  warehouseId                BigInt    @map("warehouse_id")
  fulfillmentNo              String    @unique @map("fulfillment_no") @db.VarChar(40)
  status                     String    @default("PENDING") @db.VarChar(40)
  carrierCode                String?   @map("carrier_code") @db.VarChar(64)
  trackingNo                 String?   @map("tracking_no") @db.VarChar(128)
  pickedAt                   DateTime? @map("picked_at") @db.Timestamptz(6)
  packedAt                   DateTime? @map("packed_at") @db.Timestamptz(6)
  shippedAt                  DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt                DateTime? @map("delivered_at") @db.Timestamptz(6)
  deliveryFailureReasonCode  String?   @map("delivery_failure_reason_code") @db.VarChar(64)
  returnedToWarehouseAt      DateTime? @map("returned_to_warehouse_at") @db.Timestamptz(6)
  returnCondition            String?   @map("return_condition") @db.VarChar(24)
  version                    BigInt    @default(0)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouse  Warehouse                  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  history    FulfillmentStatusHistory[]

  @@index([warehouseId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, updatedAt])
  @@index([trackingNo])
  @@map("fulfillments")
}

model FulfillmentStatusHistory {
  id              BigInt   @id @default(autoincrement())
  fulfillmentId   BigInt   @map("fulfillment_id")
  sequenceNo      Int      @map("sequence_no")
  fromStatus      String?  @map("from_status") @db.VarChar(40)
  toStatus        String   @map("to_status") @db.VarChar(40)
  reason          String?  @db.VarChar(500)
  actorId         BigInt?  @map("actor_id")
  requestId       String   @map("request_id") @db.VarChar(100)
  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(150)
  requestHash     String?  @map("request_hash") @db.Char(64)
  metadataJson    Json?    @map("metadata_json") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  fulfillment Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Restrict)
  actor       User?       @relation("FulfillmentHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([fulfillmentId, sequenceNo])
  @@unique([fulfillmentId, idempotencyKey])
  @@index([fulfillmentId, createdAt])
  @@index([requestId])
  @@index([actorId])
  @@map("fulfillment_status_history")
}

model ShippingZone {
