  id            BigInt   @id @default(autoincrement())
  code          String   @unique @db.VarChar(32)
  name          String   @db.VarChar(255)
  provinceCodes String[] @map("province_codes") @db.VarChar(32)
  status        String   @default("ACTIVE") @db.VarChar(24)
  priority      Int      @default(0)
  version       BigInt   @default(0)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates ShippingRate[]

  @@index([status, priority])
  @@map("shipping_zones")
}

model ShippingRate {
  id                    BigInt   @id @default(autoincrement())
  zoneId                BigInt   @map("zone_id")
  branchId              BigInt?  @map("branch_id")
  minWeightGrams        Int      @default(0) @map("min_weight_grams")
  maxWeightGrams        Int?     @map("max_weight_grams")
  minSubtotal           Decimal  @default(0) @map("min_subtotal") @db.Decimal(19, 2)
  maxSubtotal           Decimal? @map("max_subtotal") @db.Decimal(19, 2)
  baseFee               Decimal  @map("base_fee") @db.Decimal(19, 2)
  perKgFee              Decimal  @default(0) @map("per_kg_fee") @db.Decimal(19, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(19, 2)
  etaMinDays            Int      @map("eta_min_days")
  etaMaxDays            Int      @map("eta_max_days")
  status                String   @default("ACTIVE") @db.VarChar(24)
  version               BigInt   @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  zone             ShippingZone      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  checkoutSessions CheckoutSession[]

  @@index([zoneId, status])
  @@index([branchId, status])
  @@map("shipping_rates")
}
