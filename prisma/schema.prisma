  shippingTotal     Decimal   @default(0) @map("shipping_total") @db.Decimal(19, 2)
  taxTotal          Decimal   @default(0) @map("tax_total") @db.Decimal(19, 2)
  grandTotal        Decimal   @map("grand_total") @db.Decimal(19, 2)
  customerNote      String?   @map("customer_note") @db.VarChar(1000)
  internalNote      String?   @map("internal_note") @db.VarChar(2000)
