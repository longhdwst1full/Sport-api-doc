  etaMinDays           Int       @map("eta_min_days")
  etaMaxDays           Int       @map("eta_max_days")
  recipientSnapshot    Json      @map("recipient_snapshot") @db.JsonB
  shippingRuleSnapshot Json      @map("shipping_rule_snapshot") @db.JsonB
  idempotencyKey       String    @unique @map("idempotency_key") @db.VarChar(150)
  requestHash          String    @map("request_hash") @db.Char(64)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz(6)
  version              BigInt    @default(0)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
