generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Wave 1: Organization + IAM + append-only audit foundation.
// Catalog/Pricing models are added in the next Sprint 1 migration after this
// dependency wave is verified from an empty PostgreSQL database.

model Branch {
  id          BigInt   @id @default(autoincrement())
  legacyId    String?  @unique @map("legacy_id") @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(255)
  status      String   @default("ACTIVE") @db.VarChar(24)
  phone       String?  @db.VarChar(32)
  email       String?  @db.VarChar(255)
  addressJson Json     @map("address_json") @db.JsonB
  timezone    String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  version     BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   BigInt?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   BigInt?  @map("updated_by")

  warehouses       Warehouse[]
  roleAssignments  UserRoleAssignment[]
  carts            Cart[]
  checkoutSessions CheckoutSession[]
  shippingRates    ShippingRate[]
  orders           Order[]

  @@map("branches")
}

model Warehouse {
  id        BigInt   @id @default(autoincrement())
  legacyId  String?  @unique @map("legacy_id") @db.Uuid
  branchId  BigInt   @unique @map("branch_id")
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(255)
  status    String   @default("ACTIVE") @db.VarChar(24)
  version   BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy BigInt?  @map("created_by")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy BigInt?  @map("updated_by")

  branch                 Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  roleAssignments        UserRoleAssignment[]
  inventoryBalances      InventoryBalance[]
  inventoryMovements     InventoryMovement[]
  stockAdjustments       StockAdjustment[]
  outgoingStockTransfers StockTransfer[]        @relation("StockTransferSource")
  incomingStockTransfers StockTransfer[]        @relation("StockTransferDestination")
  checkoutSessions       CheckoutSession[]
  inventoryReservations  InventoryReservation[]
  orders                 Order[]

  @@map("warehouses")
}

model User {
  id                  BigInt    @id @default(autoincrement())
  legacyId            String?   @unique @map("legacy_id") @db.Uuid
  userType            String    @map("user_type") @db.VarChar(24)
  email               String?   @db.VarChar(255)
  normalizedEmail     String?   @map("normalized_email") @db.VarChar(255)
  phone               String?   @db.VarChar(32)
  normalizedPhone     String?   @map("normalized_phone") @db.VarChar(32)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  displayName         String    @map("display_name") @db.VarChar(255)
  status              String    @default("ACTIVE") @db.VarChar(24)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz(6)
  lockReason          String?   @map("lock_reason") @db.VarChar(255)
  emailVerifiedAt     DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt     DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  permissionVersion   BigInt    @default(0) @map("permission_version")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  version             BigInt    @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions                  AuthSession[]
  roleAssignments           UserRoleAssignment[] @relation("AssignedUser")
  assignedRoleAssignments   UserRoleAssignment[] @relation("AssignmentActor")
  permissionGrants          RolePermission[]     @relation("PermissionGrantActor")
  auditLogs                 AuditLog[]
  uploadedMedia             MediaAsset[]         @relation("MediaUploader")
  createdProducts           Product[]            @relation("ProductCreator")
  updatedProducts           Product[]            @relation("ProductUpdater")
  createdBundles            ProductBundle[]      @relation("BundleCreator")
  updatedBundles            ProductBundle[]      @relation("BundleUpdater")
  createdPrices             ProductPrice[]       @relation("PriceCreator")
  updatedPrices             ProductPrice[]       @relation("PriceUpdater")
  createdInventoryMovements InventoryMovement[]  @relation("InventoryMovementCreator")
  createdStockAdjustments   StockAdjustment[]    @relation("StockAdjustmentCreator")
  createdStockTransfers     StockTransfer[]      @relation("StockTransferCreator")
  shippedStockTransfers     StockTransfer[]      @relation("StockTransferShipper")
  receivedStockTransfers    StockTransfer[]      @relation("StockTransferReceiver")
  customerProfile           Customer?
  carts                     Cart[]

  @@map("users")
}

model AuthSession {
  id               BigInt    @id @default(autoincrement())
  legacyId         String?   @unique @map("legacy_id") @db.Uuid
  userId           BigInt    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  rotatedFromId    BigInt?   @unique @map("rotated_from_id")
  deviceId         String?   @map("device_id") @db.VarChar(128)
  deviceInfo       Json?     @map("device_info") @db.JsonB
  ipHash           String?   @map("ip_hash") @db.VarChar(128)
  userAgentHash    String?   @map("user_agent_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom AuthSession?  @relation("SessionRotation", fields: [rotatedFromId], references: [id], onDelete: SetNull)
  rotations   AuthSession[] @relation("SessionRotation")

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  legacyId    String?  @unique @map("legacy_id") @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(255)
  description String?
  status      String   @default("ACTIVE") @db.VarChar(24)
  isSystem    Boolean  @default(false) @map("is_system")
  version     BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   BigInt?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   BigInt?  @map("updated_by")

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          BigInt   @id @default(autoincrement())
  legacyId    String?  @unique @map("legacy_id") @db.Uuid
  code        String   @unique @db.VarChar(150)
  module      String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?
  isSensitive Boolean  @default(false) @map("is_sensitive")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  grantedBy    BigInt?  @map("granted_by")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantActor User?      @relation("PermissionGrantActor", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([grantedBy])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id          BigInt    @id @default(autoincrement())
  legacyId    String?   @unique @map("legacy_id") @db.Uuid
  userId      BigInt    @map("user_id")
  roleId      BigInt    @map("role_id")
  scopeType   String    @map("scope_type") @db.VarChar(24)
  branchId    BigInt?   @map("branch_id")
  warehouseId BigInt?   @map("warehouse_id")
  validFrom   DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo     DateTime? @map("valid_to") @db.Timestamptz(6)
  status      String    @default("ACTIVE") @db.VarChar(24)
  assignedBy  BigInt    @map("assigned_by")
  version     BigInt    @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User       @relation("AssignedUser", fields: [userId], references: [id], onDelete: Restrict)
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  branch      Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  assignActor User       @relation("AssignmentActor", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([roleId])
  @@index([branchId])
  @@index([warehouseId])
  @@index([assignedBy])
  @@index([status, validTo])
  @@map("user_role_assignments")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  legacyId      String?  @unique @map("legacy_id") @db.Uuid
  requestId     String   @map("request_id") @db.VarChar(100)
  sequenceNo    Int      @map("sequence_no")
  actorType     String   @map("actor_type") @db.VarChar(24)
  actorUserId   BigInt?  @map("actor_user_id")
  action        String   @db.VarChar(150)
  entityType    String   @map("entity_type") @db.VarChar(100)
  entityId      String?  @map("entity_id")
  beforeJson    Json?    @map("before_json") @db.JsonB
  afterJson     Json?    @map("after_json") @db.JsonB
  reason        String?
  ipHash        String?  @map("ip_hash") @db.VarChar(128)
  userAgentHash String?  @map("user_agent_hash") @db.VarChar(128)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@unique([requestId, sequenceNo])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([createdAt, id])
  @@map("audit_logs")
}

model MediaAsset {
  id                BigInt    @id @default(autoincrement())
  legacyId          String?   @unique @map("legacy_id") @db.Uuid
  provider          String    @db.VarChar(32)
  providerAssetId   String    @map("provider_asset_id") @db.VarChar(255)
  publicId          String    @map("public_id") @db.VarChar(500)
  resourceType      String    @default("IMAGE") @map("resource_type") @db.VarChar(24)
  secureUrl         String    @map("secure_url")
  thumbnailUrl      String?   @map("thumbnail_url")
  format            String?   @db.VarChar(32)
  mimeType          String?   @map("mime_type") @db.VarChar(100)
  width             Int?
  height            Int?
  sizeBytes         BigInt?   @map("size_bytes")
  checksum          String?   @db.VarChar(128)
  folder            String?   @db.VarChar(255)
  altText           String?   @map("alt_text") @db.VarChar(500)
  metadataJson      Json?     @map("metadata_json") @db.JsonB
  status            String    @default("ACTIVE") @db.VarChar(24)
  uploadedBy        BigInt?   @map("uploaded_by")
  providerCreatedAt DateTime? @map("provider_created_at") @db.Timestamptz(6)
  version           BigInt    @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploader       User?          @relation("MediaUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  brandLogos     Brand[]        @relation("BrandLogo")
  categoryImages Category[]     @relation("CategoryImage")
  productMedia   ProductMedia[]

  @@unique([provider, providerAssetId])
  @@index([uploadedBy])
  @@index([status, createdAt])
  @@map("media_assets")
}

model Brand {
  id          BigInt   @id @default(autoincrement())
  legacyId    String?  @unique @map("legacy_id") @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?
  logoAssetId BigInt?  @map("logo_asset_id")
  status      String   @default("ACTIVE") @db.VarChar(24)
  seoJson     Json?    @map("seo_json") @db.JsonB
  version     BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  logoAsset MediaAsset? @relation("BrandLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  products  Product[]

  @@index([logoAssetId])
  @@index([status, name])
  @@map("brands")
}

model Category {
  id           BigInt   @id @default(autoincrement())
  legacyId     String?  @unique @map("legacy_id") @db.Uuid
  parentId     BigInt?  @map("parent_id")
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  path         String   @db.VarChar(1000)
  depth        Int      @default(0)
  description  String?
  imageAssetId BigInt?  @map("image_asset_id")
  sortOrder    Int      @default(0) @map("sort_order")
  status       String   @default("ACTIVE") @db.VarChar(24)
  seoJson      Json?    @map("seo_json") @db.JsonB
  version      BigInt   @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent     Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]        @relation("CategoryTree")
  imageAsset MediaAsset?       @relation("CategoryImage", fields: [imageAssetId], references: [id], onDelete: SetNull)
  products   ProductCategory[]

  @@index([parentId, sortOrder])
  @@index([imageAssetId])
  @@index([status, name])
  @@map("categories")
}

model Product {
  id               BigInt    @id @default(autoincrement())
  legacyId         String?   @unique @map("legacy_id") @db.Uuid
  brandId          BigInt?   @map("brand_id")
  productType      String    @default("STANDARD") @map("product_type") @db.VarChar(24)
  productNo        String    @unique @map("product_no") @db.VarChar(32)
  name             String    @db.VarChar(255)
  slug             String    @unique @db.VarChar(255)
  shortDescription String?   @map("short_description")
  description      String?
  status           String    @default("DRAFT") @db.VarChar(24)
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  seoJson          Json?     @map("seo_json") @db.JsonB
  version          BigInt    @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        BigInt?   @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        BigInt?   @map("updated_by")

  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  creator    User?             @relation("ProductCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater    User?             @relation("ProductUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  categories ProductCategory[]
  variants   ProductVariant[]
  media      ProductMedia[]

  @@index([brandId])
  @@index([status, publishedAt])
  @@index([name])
  @@map("products")
}

model ProductCategory {
  productId  BigInt  @map("product_id")
  categoryId BigInt  @map("category_id")
  isPrimary  Boolean @default(false) @map("is_primary")
  sortOrder  Int     @default(0) @map("sort_order")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id          BigInt   @id @default(autoincrement())
  legacyId    String?  @unique @map("legacy_id") @db.Uuid
  productId   BigInt   @map("product_id")
  sku         String   @unique @db.VarChar(64)
  barcode     String?  @db.VarChar(64)
  name        String   @db.VarChar(255)
  weightGrams Int      @default(0) @map("weight_grams")
  lengthMm    Int?     @map("length_mm")
  widthMm     Int?     @map("width_mm")
  heightMm    Int?     @map("height_mm")
  status      String   @default("ACTIVE") @db.VarChar(24)
  version     BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product                   Product                    @relation(fields: [productId], references: [id], onDelete: Restrict)
  media                     ProductMedia[]
  bundleDefinition          ProductBundle?             @relation("BundleVariant")
  bundleComponents          BundleItem[]               @relation("BundleComponent")
  prices                    ProductPrice[]
  inventoryBalances         InventoryBalance[]
  inventoryMovements        InventoryMovement[]
  cartItems                 CartItem[]
  checkoutSessionItems      CheckoutSessionItem[]
  inventoryReservationItems InventoryReservationItem[]
  orderItems                OrderItem[]
  orderItemComponents       OrderItemComponent[]
  stockAdjustmentItems      StockAdjustmentItem[]
  stockTransferItems        StockTransferItem[]

  @@index([productId, status])
  @@map("product_variants")
}

model ProductBundle {
  id              BigInt   @id @default(autoincrement())
  legacyId        String?  @unique @map("legacy_id") @db.Uuid
  bundleVariantId BigInt   @unique @map("bundle_variant_id")
  bundleType      String   @default("FIXED_VIRTUAL") @map("bundle_type") @db.VarChar(24)
  status          String   @default("ACTIVE") @db.VarChar(24)
  version         BigInt   @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       BigInt   @map("created_by")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       BigInt   @map("updated_by")

  bundleVariant ProductVariant @relation("BundleVariant", fields: [bundleVariantId], references: [id], onDelete: Restrict)
  creator       User           @relation("BundleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater       User           @relation("BundleUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  items         BundleItem[]
  orderItems    OrderItem[]

  @@map("product_bundles")
}

model BundleItem {
  id                 BigInt  @id @default(autoincrement())
  legacyId           String? @unique @map("legacy_id") @db.Uuid
  productBundleId    BigInt  @map("product_bundle_id")
  componentVariantId BigInt  @map("component_variant_id")
  quantity           Int
  sortOrder          Int     @default(0) @map("sort_order")

  productBundle       ProductBundle        @relation(fields: [productBundleId], references: [id], onDelete: Cascade)
  componentVariant    ProductVariant       @relation("BundleComponent", fields: [componentVariantId], references: [id], onDelete: Restrict)
  orderItemComponents OrderItemComponent[]

  @@unique([productBundleId, componentVariantId])
  @@index([componentVariantId])
  @@map("bundle_items")
}

model ProductMedia {
  id           BigInt   @id @default(autoincrement())
  legacyId     String?  @unique @map("legacy_id") @db.Uuid
  productId    BigInt   @map("product_id")
  variantId    BigInt?  @map("variant_id")
  mediaAssetId BigInt   @map("media_asset_id")
  mediaType    String   @default("IMAGE") @map("media_type") @db.VarChar(24)
  altText      String?  @map("alt_text") @db.VarChar(500)
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  status       String   @default("ACTIVE") @db.VarChar(24)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_media")
}

model ProductPrice {
  id               BigInt    @id @default(autoincrement())
  legacyId         String?   @unique @map("legacy_id") @db.Uuid
  productVariantId BigInt    @map("product_variant_id")
  priceType        String    @default("REGULAR") @map("price_type") @db.VarChar(24)
  channel          String    @default("ONLINE") @db.VarChar(24)
  currencyCode     String    @default("VND") @map("currency_code") @db.Char(3)
  amount           Decimal   @db.Decimal(19, 2)
  startsAt         DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  status           String    @default("SCHEDULED") @db.VarChar(24)
  version          BigInt    @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy        BigInt    @map("created_by")
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy        BigInt    @map("updated_by")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  creator        User           @relation("PriceCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater        User           @relation("PriceUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([productVariantId, status, startsAt])
  @@map("product_prices")
}

model InventoryBalance {
  id               BigInt   @id @default(autoincrement())
  legacyId         String?  @unique @map("legacy_id") @db.Uuid
  warehouseId      BigInt   @map("warehouse_id")
  productVariantId BigInt   @map("product_variant_id")
  onHand           Int      @default(0) @map("on_hand")
  reserved         Int      @default(0)
  reorderPoint     Int      @default(0) @map("reorder_point")
  version          BigInt   @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([warehouseId, productVariantId])
  @@index([productVariantId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id               BigInt   @id @default(autoincrement())
  legacyId         String?  @unique @map("legacy_id") @db.Uuid
  warehouseId      BigInt   @map("warehouse_id")
  productVariantId BigInt   @map("product_variant_id")
  movementType     String   @map("movement_type") @db.VarChar(40)
  quantityDelta    Int      @map("quantity_delta")
  balanceAfter     Int      @map("balance_after")
  referenceType    String   @map("reference_type") @db.VarChar(64)
  referenceId      String   @map("reference_id")
  idempotencyKey   String   @unique @map("idempotency_key") @db.VarChar(200)
  reason           String
  occurredAt       DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
