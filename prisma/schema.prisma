  fulfillment     Fulfillment?
  returnRequests  ReturnRequest[]

  @@index([customerId, placedAt(sort: Desc), id(sort: Desc)])
  @@index([branchId, status, placedAt(sort: Desc), id(sort: Desc)])
  @@index([warehouseId, fulfillmentStatus])
  @@index([paymentStatus, placedAt])
