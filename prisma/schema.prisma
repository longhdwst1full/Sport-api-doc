model Order {
  id                BigInt    @id @default(autoincrement())
  orderNo           String    @unique @map("order_no") @db.VarChar(32)
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(150)
  requestHash       String    @map("request_hash") @db.Char(64)
  checkoutSessionId BigInt    @unique @map("checkout_session_id")
  reservationId     BigInt    @unique @map("reservation_id")
