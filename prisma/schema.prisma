  campaign             FlashSaleCampaign           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  productVariant       ProductVariant              @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reservations         FlashSaleQuotaReservation[]
  checkoutSessionItems CheckoutSessionItem[]

