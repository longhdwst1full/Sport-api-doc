  branchId          BigInt    @map("branch_id")
  warehouseId       BigInt    @map("warehouse_id")
  channel           String    @default("WEB") @db.VarChar(24)
  status            String    @default("PENDING_CONFIRMATION") @db.VarChar(32)
  paymentStatus     String    @default("PENDING") @map("payment_status") @db.VarChar(32)
  fulfillmentStatus String    @default("PENDING") @map("fulfillment_status") @db.VarChar(32)
