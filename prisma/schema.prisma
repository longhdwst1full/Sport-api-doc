model FlashSaleQuotaReservation {
  id                BigInt    @id @default(autoincrement())
  flashSaleItemId   BigInt    @map("flash_sale_item_id")
  checkoutSessionId BigInt    @map("checkout_session_id")
  productVariantId  BigInt    @map("product_variant_id")
  customerKey       String    @map("customer_key") @db.VarChar(150)
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(150)
  quantity          Int
  status            String    @default("ACTIVE") @db.VarChar(24)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  committedAt       DateTime? @map("committed_at") @db.Timestamptz(6)
  releasedAt        DateTime? @map("released_at") @db.Timestamptz(6)
  releaseReason     String?   @map("release_reason") @db.VarChar(500)
  version           BigInt    @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  flashSaleItem   FlashSaleItem   @relation(fields: [flashSaleItemId], references: [id], onDelete: Restrict)
  checkoutSession CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  productVariant  ProductVariant  @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([flashSaleItemId, checkoutSessionId])
  @@unique([checkoutSessionId, productVariantId])
  @@index([status, expiresAt, id])
  @@index([checkoutSessionId, status])
  @@index([customerKey, flashSaleItemId, status])
  @@map("flash_sale_quota_reservations")
}

// CMS và Review V1 — xem `document/09-v1-model.dbml` cho mô hình đích.
// Các cột đánh dấu "đích" giữ đúng tên trong DBML nhưng nullable ở V1 vì luồng
// tạo review theo đơn hàng đã mua và luồng upload ảnh bìa qua media asset chưa
// tồn tại. Khi hai luồng đó ra đời thì backfill rồi siết NOT NULL, không đổi tên cột.
model ContentPost {
  id                  BigInt    @id @default(autoincrement())
  postType            String    @map("post_type") @db.VarChar(32)
  slug                String    @unique @db.VarChar(255)
  title               String    @db.VarChar(255)
  excerpt             String
  body                String
  coverUrl            String    @map("cover_url")
  coverAssetId        BigInt?   @map("cover_asset_id")
  relatedProductSlugs Json      @default("[]") @map("related_product_slugs") @db.JsonB
  status              String    @default("PUBLISHED") @db.VarChar(24)
  isPublished         Boolean   @default(true) @map("is_published")
  publishedAt         DateTime  @map("published_at") @db.Timestamptz(6)
  archivedAt          DateTime? @map("archived_at") @db.Timestamptz(6)
  archiveReason       String?   @map("archive_reason") @db.VarChar(255)
  version             BigInt    @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  coverAsset MediaAsset? @relation("ContentPostCover", fields: [coverAssetId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([postType, status])
  @@index([isPublished, publishedAt(sort: Desc)], map: "posts_is_published_idx")
  @@map("posts")
}

model ProductReview {
  id                  BigInt    @id @default(autoincrement())
  productSlug         String    @map("product_slug") @db.VarChar(255)
  productId           BigInt?   @map("product_id")
  customerDisplayName String    @map("customer_display_name") @db.VarChar(255)
  customerId          BigInt?   @map("customer_id")
  orderItemId         BigInt?   @map("order_item_id")
  rating              Int       @db.SmallInt
  title               String    @db.VarChar(255)
  content             String
  verifiedPurchase    Boolean   @default(false) @map("verified_purchase")
  status              String    @default("APPROVED") @db.VarChar(24)
  moderationReason    String?   @map("moderation_reason")
  moderatedAt         DateTime? @map("moderated_at") @db.Timestamptz(6)
  moderatedBy         BigInt?   @map("moderated_by")
  version             BigInt    @default(0)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product   Product?               @relation(fields: [productId], references: [id], onDelete: Restrict)
  customer  Customer?              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderItem OrderItem?             @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  moderator User?                  @relation("ProductReviewModerator", fields: [moderatedBy], references: [id], onDelete: Restrict)
  comments  ProductReviewComment[]

  @@index([productSlug, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([productId])
  @@index([customerId])
  @@index([orderItemId])
  @@index([moderatedBy])
  @@map("product_reviews")
}

model ProductReviewComment {
  id              BigInt   @id @default(autoincrement())
  productReviewId BigInt   @map("product_review_id")
  authorType      String   @map("author_type") @db.VarChar(24)
  authorName      String   @map("author_name") @db.VarChar(255)
  authorUserId    BigInt?  @map("author_user_id")
  content         String
  status          String   @default("PUBLISHED") @db.VarChar(24)
  version         BigInt   @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  review ProductReview @relation(fields: [productReviewId], references: [id], onDelete: Restrict)
  author User?         @relation("ProductReviewCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([productReviewId, createdAt])
  @@index([authorUserId])
  @@map("product_review_comments")
}

model SystemParameter {
  id           BigInt   @id @default(autoincrement())
  code         String   @unique @db.VarChar(64)
  groupCode    String   @map("group_code") @db.VarChar(32)
  label        String   @db.VarChar(255)
  description  String?
  valueType    String   @map("value_type") @db.VarChar(16)
  value        String
  defaultValue String   @map("default_value")
  minValue     Decimal? @map("min_value") @db.Decimal(19, 2)
  maxValue     Decimal? @map("max_value") @db.Decimal(19, 2)
  unit         String?  @db.VarChar(32)
  sortOrder    Int      @default(0) @map("sort_order")
  status       String   @default("ACTIVE") @db.VarChar(24)
  isPublic     Boolean  @default(false) @map("is_public")
  isSystem     Boolean  @default(false) @map("is_system")
  isSecret     Boolean  @default(false) @map("is_secret")
  remarks      String?  @db.VarChar(500)
  version      BigInt   @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    BigInt?  @map("created_by")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy    BigInt?  @map("updated_by")

  creator User? @relation("SystemParameterCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User? @relation("SystemParameterUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@index([groupCode, sortOrder])
  @@index([status])
  @@index([isPublic])
  @@index([isSystem])
  @@map("system_parameters")
}

/// Hàng đợi việc-cần-làm-sau, ghi cùng transaction với nghiệp vụ sinh ra nó.
///
/// Gửi email ngay trong transaction đặt hàng là buộc đơn hàng vào tình trạng của Mailtrap: nhà cung
/// cấp chậm thì đơn chậm theo, nhà cung cấp lỗi thì hoặc mất email hoặc rollback cả đơn. Ghi ý định
/// xuống bảng này thì transaction nghiệp vụ đóng ngay, còn worker lo việc gửi và có quyền thử lại.
model OutboxEvent {
  id            BigInt    @id @default(autoincrement())
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   BigInt    @map("aggregate_id")
  eventType     String    @map("event_type") @db.VarChar(150)
  eventVersion  Int       @default(1) @map("event_version")
  payloadJson   Json      @map("payload_json") @db.JsonB
  status        String    @default("PENDING") @db.VarChar(24)
  attempts      Int       @default(0)
  /// Thời điểm sớm nhất được lấy ra xử lý; backoff đẩy mốc này về tương lai.
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy      String?   @map("locked_by") @db.VarChar(100)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt, id])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

/// Nhật ký gửi thông báo: mỗi dòng là một lần gửi tới một người nhận.
///
/// `dedup_key` unique theo kênh là chốt chặn gửi trùng: worker chạy lại, hoặc hai replica cùng lấy
/// một event, thì lần thứ hai vi phạm unique và dừng thay vì gửi thêm một email nữa cho khách.
model Notification {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt?   @map("user_id")
  customerId      BigInt?   @map("customer_id")
  /// Mã template nằm trong mã nguồn (`notification.templates.ts`), không phải bảng riêng — V1 chưa
  /// có nhu cầu cho người ngoài team sửa nội dung email.
  templateCode    String    @map("template_code") @db.VarChar(64)
  channel         String    @db.VarChar(24)
  dedupKey        String    @map("dedup_key") @db.VarChar(150)
  /// SECURITY: chỉ lưu bản che (a***@example.com); nhật ký không phải chỗ giữ PII đầy đủ.
  recipientMasked String    @map("recipient_masked") @db.VarChar(255)
  payloadJson     Json      @map("payload_json") @db.JsonB
  status          String    @default("PENDING") @db.VarChar(24)
  attemptCount    Int       @default(0) @map("attempt_count")
  nextAttemptAt   DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(6)
  providerMessageId String? @map("provider_message_id") @db.VarChar(255)
  errorCode       String?   @map("error_code") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([channel, dedupKey])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

/// Token đặt lại mật khẩu: một lần dùng, có hạn.
///
/// SECURITY: chỉ lưu hash. Rò database thì kẻ tấn công không dựng lại được link trong email, đúng
/// cách `auth_sessions` đang làm với refresh token. `used_at` là chốt một-lần: ai đọc được email cũ
/// (máy dùng chung, hộp thư bị chuyển tiếp) cũng không đổi lại mật khẩu lần nữa.
model PasswordResetToken {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  tokenHash     String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(6)
  /// Hash IP của lần yêu cầu, để điều tra lạm dụng mà không lưu IP thô.
  requestIpHash String?   @map("request_ip_hash") @db.VarChar(128)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Phiếu trả hàng (RMA) của một đơn đã giao.
///
/// INVARIANT: tối đa MỘT phiếu đang mở cho mỗi đơn (partial unique index trong migration). Chi
/// nhánh và kho là snapshot của đơn lúc tạo phiếu: hàng trả phải về đúng kho đã xuất, và phạm vi
/// dữ liệu lọc theo chi nhánh của phiếu chứ không theo kho hiện tại của sản phẩm.
model ReturnRequest {
  id                 BigInt    @id @default(autoincrement())
  returnNo           String    @unique @map("return_no") @db.VarChar(32)
  orderId            BigInt    @map("order_id")
  customerId         BigInt    @map("customer_id")
  branchId           BigInt    @map("branch_id")
  warehouseId        BigInt    @map("warehouse_id")
  status             String    @default("REQUESTED") @db.VarChar(24)
  channel            String    @db.VarChar(16)
  reasonCode         String    @map("reason_code") @db.VarChar(32)
  description        String?   @db.VarChar(2000)
  /// Ảnh minh chứng đã xác minh với Cloudinary: [{ publicId, url, thumbnailUrl, width, height, sizeBytes, uploaderType, uploadedBy }].
  evidenceImages     Json?     @map("evidence_images") @db.JsonB
  fault              String?   @db.VarChar(16)
  deliveredAt        DateTime  @map("delivered_at") @db.Timestamptz(6)
  windowOverrideBy   BigInt?   @map("window_override_by")
  windowOverrideNote String?   @map("window_override_note") @db.VarChar(500)
  /// Trần tiền hoàn của phiếu, chốt lúc nhận hàng: tổng trần từng dòng cộng phí giao khi lỗi shop.
  refundCap          Decimal?  @map("refund_cap") @db.Decimal(19, 2)
  idempotencyKey     String    @unique @map("idempotency_key") @db.VarChar(150)
  requestHash        String    @map("request_hash") @db.Char(64)
  createdBy          BigInt    @map("created_by")
  decidedBy          BigInt?   @map("decided_by")
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote       String?   @map("decision_note") @db.VarChar(500)
  receivedBy         BigInt?   @map("received_by")
  receivedAt         DateTime? @map("received_at") @db.Timestamptz(6)
  closedAt           DateTime? @map("closed_at") @db.Timestamptz(6)
  version            BigInt    @default(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order     Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer  Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch    Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items     ReturnItem[]
  refunds   Refund[]
  history   ReturnStatusHistory[]

  @@index([orderId])
  @@index([customerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([branchId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([warehouseId])
  @@map("return_requests")
}

/// Một dòng hàng trả. Combo trả nguyên dòng (tham chiếu `order_items` cha, không tách thành phần).
model ReturnItem {
  id              BigInt   @id @default(autoincrement())
  returnRequestId BigInt   @map("return_request_id")
  orderItemId     BigInt   @map("order_item_id")
  quantity        Int
  condition       String?  @db.VarChar(16)
  disposition     String?  @db.VarChar(16)
  restockQty      Int      @default(0) @map("restock_qty")
  /// Trần tiền hoàn của dòng, chốt lúc nhận hàng theo giá cuối cùng khách đã trả; MISSING là 0.
  refundCap       Decimal? @map("refund_cap") @db.Decimal(19, 2)
  note            String?  @db.VarChar(500)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

/// Lịch sử append-only của phiếu trả, kể cả thao tác không đổi trạng thái (tạo/xác nhận hoàn tiền).
///
/// IDEMPOTENCY: `(return_request_id, idempotency_key)` là khoá replay của mọi lệnh trên phiếu.
model ReturnStatusHistory {
  id              BigInt   @id @default(autoincrement())
  returnRequestId BigInt   @map("return_request_id")
  sequenceNo      Int      @map("sequence_no")
  action          String   @db.VarChar(32)
  fromStatus      String?  @map("from_status") @db.VarChar(24)
  toStatus        String   @map("to_status") @db.VarChar(24)
  reason          String?  @db.VarChar(500)
  actorType       String   @map("actor_type") @db.VarChar(16)
  actorId         BigInt?  @map("actor_id")
  requestId       String   @map("request_id") @db.VarChar(100)
  idempotencyKey  String?  @map("idempotency_key") @db.VarChar(150)
  requestHash     String?  @map("request_hash") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)

  @@unique([returnRequestId, sequenceNo])
  @@unique([returnRequestId, idempotencyKey])
  @@index([requestId])
  @@map("return_status_history")
}

/// Một lượt hoàn tiền thủ công (tiền mặt hoặc chuyển khoản) cho phiếu trả.
///
/// Một phiếu có thể có nhiều dòng: lượt chuyển khoản lỗi thì đánh FAILED rồi tạo lượt mới. Tổng
/// PENDING + SUCCEEDED không vượt trần của phiếu và số tiền đã thu của payment (kiểm trong
/// transaction đã khoá); partial unique index chặn hai lượt PENDING song song.
model Refund {
  id              BigInt    @id @default(autoincrement())
  refundNo        String    @unique @map("refund_no") @db.VarChar(32)
  returnRequestId BigInt    @map("return_request_id")
  paymentId       BigInt    @map("payment_id")
  method          String    @db.VarChar(16)
  amount          Decimal   @db.Decimal(19, 2)
  currencyCode    String    @default("VND") @map("currency_code") @db.Char(3)
  status          String    @default("PENDING") @db.VarChar(16)
  externalRef     String?   @map("external_ref") @db.VarChar(255)
  /// Ảnh chứng từ chuyển/trả tiền đã xác minh, lưu khi xác nhận để đối chiếu về sau; cùng hình dạng với evidence_images.
  proofImages     Json?     @map("proof_images") @db.JsonB
  note            String?   @db.VarChar(500)
  idempotencyKey  String    @unique @map("idempotency_key") @db.VarChar(150)
  requestHash     String    @map("request_hash") @db.Char(64)
  requestedBy     BigInt    @map("requested_by")
  processedBy     BigInt?   @map("processed_by")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  failureReason   String?   @map("failure_reason") @db.VarChar(500)
  version         BigInt    @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([returnRequestId, createdAt])
  @@index([paymentId, status])
  @@map("refunds")
}
