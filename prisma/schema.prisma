model FlashSaleCampaign {
  id          BigInt   @id @default(autoincrement())
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(255)
  description String?
  startsAt    DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime @map("ends_at") @db.Timestamptz(6)
  status      String   @default("DRAFT") @db.VarChar(24)
  version     BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   BigInt?  @map("created_by")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   BigInt?  @map("updated_by")

  creator User?              @relation("FlashSaleCampaignCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater User?              @relation("FlashSaleCampaignUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  items   FlashSaleItem[]

  @@index([status, startsAt, endsAt])
  @@map("flash_sale_campaigns")
}

model FlashSaleItem {
  id               BigInt   @id @default(autoincrement())
  campaignId       BigInt   @map("campaign_id")
  productVariantId BigInt   @map("product_variant_id")
  salePrice        Decimal  @map("sale_price") @db.Decimal(19, 2)
  currencyCode     String   @default("VND") @map("currency_code") @db.Char(3)
  quota            Int
  soldQuantity     Int      @default(0) @map("sold_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  perCustomerLimit Int?     @map("per_customer_limit")
  status           String   @default("ACTIVE") @db.VarChar(24)
  version          BigInt   @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
