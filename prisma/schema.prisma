  placedAt          DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?   @map("cancel_reason") @db.VarChar(500)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)
  version           BigInt    @default(0)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  checkoutSession CheckoutSession      @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  reservation     InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
