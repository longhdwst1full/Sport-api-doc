  "info": {
    "title": "DCTD-UTC Commerce API",
    "description": "Contract for storefront and admin applications",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "dctd-api"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "timestamp"
        ]
      },
      "SystemModuleDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "SCAFFOLDED"
            ]
          },
          "tables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "p0Count": {
            "type": "number"
          },
          "p1Count": {
            "type": "number"
          }
        },
        "required": [
          "key",
          "name",
          "status",
          "tables",
          "p0Count",
          "p1Count"
        ]
      },
      "SystemModuleListDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SystemModuleDto"
            }
          },
          "totalModels": {
            "type": "number",
            "example": 74
          },
          "p0Models": {
            "type": "number",
            "example": 43
          },
          "p1Models": {
            "type": "number",
            "example": 31
          }
        },
        "required": [
          "items",
          "totalModels",
          "p0Models",
          "p1Models"
        ]
      },
      "ProductSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Máy chạy bộ DCTD Pro X1"
          },
          "slug": {
            "type": "string",
            "example": "may-chay-bo-dctd-pro-x1"
          },
          "brand": {
            "type": "string",
            "example": "DCTD"
          },
          "category": {
            "type": "string",
            "example": "Máy chạy bộ"
          },
          "price": {
            "type": "number",
            "example": 18990000
          },
          "currency": {
            "type": "string",
            "example": "VND"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "rating": {
            "type": "number",
            "example": 4.8
          },
          "reviewCount": {
            "type": "number",
            "example": 124
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "tags": {
            "example": [
              "Bán chạy",
              "Giao nhanh"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "brand",
          "category",
          "price",
          "currency",
          "imageUrl",
          "rating",
          "reviewCount",
          "available",
          "tags"
        ]
      },
      "ProductListMetaDto": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 12
          },
          "total": {
            "type": "number",
            "example": 2
          },
          "totalPages": {
            "type": "number",
            "example": 1
          }
        },
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ]
      },
      "ProductListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummaryDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ProductListMetaDto"
          }
        },
        "required": [
          "items",
          "meta"
        ]
      },
      "ProductVariantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "availableQuantity": {
            "type": "number"
          },
          "attributes": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "sku",
          "name",
          "price",
          "availableQuantity",
          "attributes"
        ]
      },
      "BundleComponentDto": {
        "type": "object",
        "properties": {
          "componentSku": {
            "type": "string"
          },
          "componentName": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "componentSku",
          "componentName",
          "quantity"
        ]
      },
      "ProductBundleDto": {
        "type": "object",
        "properties": {
          "bundleType": {
            "type": "string",
            "enum": [
              "FIXED"
            ]
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleComponentDto"
            }
          }
        },
        "required": [
          "bundleType",
          "components"
        ]
      },
      "ProductDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Máy chạy bộ DCTD Pro X1"
          },
          "slug": {
            "type": "string",
            "example": "may-chay-bo-dctd-pro-x1"
          },
          "brand": {
            "type": "string",
            "example": "DCTD"
          },
          "category": {
            "type": "string",
            "example": "Máy chạy bộ"
          },
          "price": {
            "type": "number",
            "example": 18990000
          },
          "currency": {
            "type": "string",
            "example": "VND"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "rating": {
            "type": "number",
            "example": 4.8
          },
          "reviewCount": {
            "type": "number",
            "example": 124
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "tags": {
            "example": [
              "Bán chạy",
              "Giao nhanh"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "sku": {
            "type": "string",
            "example": "SKU-RUN-X1"
          },
          "availableQuantity": {
            "type": "number",
            "example": 12
          },
          "gallery": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductVariantDto"
            }
          },
          "bundle": {
            "$ref": "#/components/schemas/ProductBundleDto"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "brand",
          "category",
          "price",
          "currency",
          "imageUrl",
          "rating",
          "reviewCount",
          "available",
          "tags",
          "description",
          "sku",
          "availableQuantity",
          "gallery",
          "variants"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string",
            "example": "Request validation failed"
          },
          "details": {
            "type": "object"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/catalog/products"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "requestId": {
            "type": "string"
          }
        },
        "required": [
          "statusCode",
          "code",
          "message",
          "path",
          "timestamp"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "availableQuantity": {
            "type": "number",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": "boolean",
            "default": true
          }
        },
        "required": [
          "name",
          "slug",
          "sku",
          "brand",
          "category",
          "description",
          "price",
          "imageUrl",
          "availableQuantity"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "availableQuantity": {
            "type": "number",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
