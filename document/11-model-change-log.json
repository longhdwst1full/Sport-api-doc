            "Cho phép NULL": "NO",
            "Ý nghĩa / trạng thái cho phép": "USER|SYSTEM|GUEST; USER bắt buộc actor_user_id"
          }
        },
        {
          "sheet": "Columns",
          "match": { "Tên bảng": "audit_logs", "Tên cột": "actor_user_id" },
          "columns": ["Cho phép NULL", "Ý nghĩa / trạng thái cho phép"],
          "set": {
            "Cho phép NULL": "YES",
            "Ý nghĩa / trạng thái cho phép": "FK RESTRICT; SYSTEM/GUEST phải null"
          }
        }
      ]
    },
