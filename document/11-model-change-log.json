      "id": "DB-20260829-AUDIT-HARDENING",
      "date": "2026-08-29",
      "scope": "DATABASE",
      "summary": "Audit log append-only cho UPDATE/DELETE/TRUNCATE; actor USER bắt buộc có actor_user_id và lịch sử actor dùng FK RESTRICT.",
      "sources": [
        "migration:20260829170000_audit_log_hardening",
        "test:database-foundation.integration-spec.ts"
      ],
      "targets": [
        {
          "sheet": "Tables",
          "match": { "Tên bảng": "audit_logs" },
          "columns": ["Khóa ngoại quan trọng", "Unique / CHECK", "Retention"],
          "set": {
            "Khóa ngoại quan trọng": "actor_user_id->users RESTRICT",
            "Unique / CHECK": "request+sequence UQ; actor consistency CHECK; reject UPDATE/DELETE/TRUNCATE",
            "Retention": "10 years proposed; no physical delete"
          }
        },
        {
          "sheet": "Columns",
          "match": { "Tên bảng": "audit_logs", "Tên cột": "actor_type" },
          "columns": ["Cho phép NULL", "Ý nghĩa / trạng thái cho phép"],
