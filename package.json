{
  "name": "@dctd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn start:dev",
    "build": "yarn prisma:validate && yarn prisma:generate && yarn prisma:migrate:on-deploy && nest build",
    "start": "node scripts/start.cjs",
    "prestart:dev": "yarn prisma:generate && yarn prisma:migrate:on-start",
    "start:dev": "nest start --watch",
    "prisma:generate": "node scripts/run-prisma.cjs generate",
    "prisma:validate": "node scripts/run-prisma.cjs validate",
    "prisma:migrate:deploy": "node scripts/run-prisma.cjs migrate-deploy",
    "prisma:migrate:status": "node scripts/run-prisma.cjs migrate-status",
    "prisma:migrate:on-start": "node scripts/migrate-on-start.cjs",
    "prisma:migrate:on-deploy": "node scripts/migrate-on-start.cjs --deploy",
    "prisma:migrate:only": "node scripts/migrate-on-start.cjs --force",
    "prisma:seed": "tsx --env-file-if-exists=.env.local prisma/seed.ts",
    "prisma:seed:demo": "tsx --env-file-if-exists=.env.local prisma/seed-demo.ts",
    "prisma:admin:reset": "tsx --env-file-if-exists=.env.local scripts/reset-bootstrap-admin.ts",
    "db:status": "yarn prisma:migrate:status",
    "db:migrate": "yarn prisma:migrate:deploy",
    "db:migrate:on-start": "yarn prisma:migrate:on-start",
    "db:migrate:only": "yarn prisma:migrate:only",
    "db:seed": "yarn prisma:seed",
    "db:seed:demo": "yarn prisma:seed && yarn prisma:seed:demo",
    "db:admin:reset": "yarn prisma:admin:reset",
    "telegram:webhook:info": "node scripts/configure-telegram-webhook.cjs info",
    "telegram:webhook:set": "node scripts/configure-telegram-webhook.cjs set",
    "telegram:webhook:delete": "node scripts/configure-telegram-webhook.cjs delete",
    "openapi:generate": "yarn build && node scripts/generate-openapi.cjs",
    "contracts:generate": "yarn openapi:generate",
    "contracts:check": "yarn contracts:generate && git diff --exit-code -- openapi document/api",
    "docs:model:annotate": "node scripts/annotate-model-workbook.cjs",
    "lint": "eslint \"{src,scripts,test}/**/*.ts\"",
    "test": "jest",
    "test:integration": "node --env-file-if-exists=.env.local scripts/run-jest.cjs --config test/jest-integration.json --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/run-jest.cjs --config test/jest-e2e.json",
    "verify": "yarn lint && yarn test && yarn build",
    "gitnexus:analyze": "npx --yes gitnexus@1.6.9 analyze"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cloudinary": "2.11.0",
    "compression": "1.8.1",
    "helmet": "8.1.0",
    "libphonenumber-js": "1.13.12",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "exceljs": "4.4.0",
    "globals": "16.3.0",
    "jest": "30.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "yaml": "2.9.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
