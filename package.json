{
  "name": "sport-api-repository",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "api"
  ],
  "scripts": {
    "dev": "yarn workspace @dctd/api start:dev",
    "contracts:generate": "yarn workspace @dctd/api openapi:generate",
    "contracts:check": "yarn contracts:generate && git diff --exit-code -- api/openapi document/api",
    "db:status": "yarn workspace @dctd/api prisma:migrate:status",
    "db:migrate": "yarn workspace @dctd/api prisma:migrate:deploy",
    "db:seed": "yarn workspace @dctd/api prisma:seed",
    "db:seed:demo": "yarn db:seed && yarn workspace @dctd/api prisma:seed:demo",
    "db:admin:reset": "yarn workspace @dctd/api prisma:admin:reset",
    "build": "yarn contracts:generate && yarn workspace @dctd/api build",
    "test": "yarn workspace @dctd/api test",
    "lint": "yarn workspace @dctd/api lint",
    "verify": "yarn lint && yarn test && yarn build",
    "gitnexus:analyze": "node .gitnexus/run.cjs analyze",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "gitnexus": "1.6.9",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "yarn": ">=1.22.0"
  }
}
